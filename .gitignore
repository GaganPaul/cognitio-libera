# ============================================================
# Cognitio Libera - Git Ignore Rules
# Tagline: Practice. Understand. Improve.
# ============================================================

# ------------------------------------------------------------
# 1. Environment Variables, Secrets & Sensitive Credentials
# ------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example

# Secret keys, certificates, tokens & credentials
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.token
*.secret
credentials.json
client_secret*.json
service-account*.json
service_account*.json
firebase-adminsdk*.json

# Local Databases & storage
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
cognitio_libera.db

# ------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------
# 3. Node, Vite & Frontend Build Artifacts
# ------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
frontend/dist/
frontend/.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# CRITICAL: Ensure frontend source code is never ignored
!frontend/src/lib/
!frontend/src/lib/**

# ------------------------------------------------------------
# 4. Operating System & Editor Artifacts
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
ehthumbs.db
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
