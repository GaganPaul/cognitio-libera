# ============================================================
# COGNITIO LIBERA - ENVIRONMENT CONFIGURATION
# Tagline: Practice. Understand. Improve.
# ============================================================

# ------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI)
# ------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL or local SQLite fallback)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Supabase connection pooler (Render recommended): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./cognitio_libera.db

# Supabase Auth & Storage API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (Exclusively for code validation, problem generation, quiz verification, and AI mentor)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------
# FRONTEND CONFIGURATION (React + Vite)
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client.
# NEVER expose GEMINI_API_KEY or SUPABASE_SERVICE_ROLE_KEY here.
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
